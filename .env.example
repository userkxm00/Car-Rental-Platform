# KAVRIQO — Environment Contract
# Placeholders only. Never commit real secrets.
# Real values are supplied by the active development/deployment environment.
# Compatible mechanisms include local env, Docker/Compose secrets, Replit Secrets,
# CI/CD secret stores, and cloud secret managers.

# ==================================================
# Runtime
# ==================================================
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info

# Public application URLs
WEB_APP_URL=http://localhost:3000
AGENCY_WEB_URL=http://localhost:3001
PLATFORM_ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000

# ==================================================
# PostgreSQL / PostGIS — authoritative application database
# ==================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/car_rental?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/car_rental?schema=public

# ==================================================
# Supabase Auth — Identity Provider only
# ==================================================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
# Server-only credential, only when required by the integration boundary.
SUPABASE_SERVICE_ROLE_KEY=

# ==================================================
# Maps — MapLibre renderer + MapTiler Cloud provider
# ==================================================
# Frontend-facing provider key; restrict by allowed origins/referrers in provider settings.
MAPTILER_API_KEY=
MAP_PROVIDER=maptiler

# ==================================================
# Object Storage — Cloudflare R2 (S3-compatible)
# ==================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kavriqo-private
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# ==================================================
# Redis — cache/jobs/rate limiting only
# ==================================================
REDIS_URL=redis://localhost:6379

# ==================================================
# Observability
# ==================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ==================================================
# Application security / cryptography
# ==================================================
APP_ENCRYPTION_KEY=

# ==================================================
# Messaging providers — enabled only by approved implementation
# ==================================================
EMAIL_PROVIDER=none
SMS_PROVIDER=none
WHATSAPP_PROVIDER=none

# ==================================================
# Payments
# ==================================================
PAYMENT_PROVIDER=manual
CHARGILY_ENABLED=false
CHARGILY_PUBLIC_KEY=
CHARGILY_SECRET_KEY=

# ==================================================
# Product configuration
# ==================================================
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=ar,fr,en
DEFAULT_CURRENCY=DZD

# ==================================================
# Background jobs
# ==================================================
QUEUE_ENABLED=true
