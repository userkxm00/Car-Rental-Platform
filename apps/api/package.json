{
  "name": "@kavriqo/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "KAVRIQO NestJS modular-monolith API — authoritative backend for all clients",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prestart": "npm run build --workspace @kavriqo/config",
    "prestart:dev": "npm run build --workspace @kavriqo/config",
    "prestart:prod": "npm run build --workspace @kavriqo/config",
    "prebuild": "npm run build --workspace @kavriqo/config",
    "pretypecheck": "npm run build --workspace @kavriqo/config",
    "pretest": "npm run build --workspace @kavriqo/config",
    "pretest:e2e": "npm run build --workspace @kavriqo/config",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(jose)/)"
    ],
    "moduleNameMapper": {
      "^@kavriqo/config$": "<rootDir>/../../../packages/config/dist/index.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@kavriqo/config": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "arabic-reshaper": "^1.1.0",
    "dotenv": "^17.2.0",
    "jose": "^6.2.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@prisma/internals": "^6.19.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.30",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pdfjs-dist": "^6.3.289",
    "prisma": "^6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
