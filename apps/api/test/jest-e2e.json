{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["/node_modules/(?!(jose)/)"],
  "moduleNameMapper": {
    "^@kavriqo/config$": "<rootDir>/../../../packages/config/dist/index.js"
  }
}
