// KAVRIQO database schema — Phase 01 baseline.
//
// Authority: architecture/database-schema-v1.md (logical model),
// architecture/database-architecture.md (Prisma + PostGIS boundary),
// docs/35-database-and-backend-foundations.md.
//
// Conventions:
// - Prisma is the primary data-access layer; PostGIS-specific fields and
//   queries use the documented narrow SQL adapter boundary (not yet needed
//   in Phase 01 — no geographic types in the users baseline).
// - No secrets (passwords/tokens) are ever stored: identity is external
//   (Supabase Auth) and only provider subjects are linked.

generator client {
  provider = "prisma-client-js"
  // Driver-adapter (pg) engine mode: no native engine download is needed,
  // which also keeps generation fully offline-capable.
  engineType = "client"
  // Generated client must sit inside apps/api/node_modules so
  // @prisma/client's `require('.prisma/client')` resolves it.
  output = "../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Global identity record (architecture/database-schema-v1.md §2).
/// At least one supported login identifier is required (email or phone —
/// enforced by a CHECK constraint added in the migration SQL).
model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String?          @unique
  phone           String?          @unique
  displayName     String
  preferredLocale String           @default("en")
  timezone        String?
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  identities       UserIdentity[]
  memberships      Membership[]
  quoteRecords     QuoteRecord[]
  bookingsCreated    Booking[] @relation("BookingCreator")
  customerProfiles Customer[]
  favorites        CustomerFavorite[]
  recentlyViewed   RecentlyViewedVehicle[]
  searchHistory    SearchHistoryEntry[]

  @@map("users")
}

/// Provider subject → application user link. Provider identifiers stay in
/// this table and never leak into domain entities.
model UserIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

/// Agency/company account (architecture/database-schema-v1.md §2 tenants).
/// Every tenant-owned table references tenantId; tenant scope is enforced by
/// repository helpers (02-D02), never by client-supplied identifiers.
model Tenant {
  id                String                   @id @default(uuid()) @db.Uuid
  name              String
  legalName         String?
  slug              String                   @unique
  defaultLocale     String                   @default("en")
  defaultTimezone   String?
  defaultCurrency   String                   @default("DZD")
  status            TenantStatus             @default(ACTIVE)
  marketplaceEnabled Boolean                 @default(false)
  verificationStatus TenantVerificationStatus @default(UNVERIFIED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  memberships       Membership[]
  locations         Location[]
  branches          Branch[]
  deliveryZones     DeliveryZone[]
  vehicleCategories VehicleCategory[]
  vehicles          Vehicle[]
  vehicleBlocks     VehicleBlock[]
  bookingHolds      BookingHold[]
  quoteRecords      QuoteRecord[]
  bookings          Booking[]
  bookingCounter    BookingCounter?
  idempotencyRecords BookingIdempotencyRecord[]
  ratePlans         RatePlan[]
  promotions        Promotion[]
  coupons           Coupon[]
  extras            Extra[]
  feeRules          FeeRule[]
  depositPolicies   DepositPolicy[]
  customers         Customer[]

  @@map("tenants")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DECLINED
  REMOVED
}

/// Relation between a user and an agency (architecture/database-schema-v1.md
/// §2 memberships). One user may belong to multiple agencies; within one
/// agency the pair is unique.
model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  status    MembershipStatus @default(INVITED)
  invitedAt DateTime         @default(now())
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Assigns one or more roles to a membership (architecture/
/// database-schema-v1.md §2 membership_roles). Role keys are the versioned
/// catalog in apps/api/src/authorization/roles.ts (validated server-side).
model MembershipRole {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @db.Uuid
  role         String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@map("membership_roles")
}

enum BranchStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum LocationType {
  BRANCH
  AIRPORT
  HOTEL
  PARKING
  PICKUP_POINT
  CUSTOM
}

/// Canonical location entity (architecture/database-schema-v1.md §3).
/// tenantId null = platform/global location. The PostGIS geometry column is
/// added with the spatial search phase via the documented SQL adapter
/// boundary; lat/lng columns serve the display fallback.
model Location {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String?                @db.Uuid
  type           LocationType           @default(CUSTOM)
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  countryCode    String                 @default("DZ")
  latitude       Float?
  longitude      Float?
  providerName   String?
  providerPlaceId String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches       Branch[]
  hours          LocationHours[]
  hourExceptions LocationHourException[]

  @@index([tenantId])
  @@map("locations")
}

/// Branch (architecture/database-schema-v1.md §3). Code is unique within a
/// tenant; the referenced location must be global or owned by the same
/// tenant (enforced by the branches service, 02-C03).
model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  name       String
  code       String
  locationId String       @db.Uuid
  status     BranchStatus @default(ACTIVE)
  timezone   String?
  contacts   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  vehicles     Vehicle[]
  quotePickups   QuoteRecord[] @relation("QuotePickupBranch")
  quoteReturns   QuoteRecord[] @relation("QuoteReturnBranch")
  bookingPickups Booking[]     @relation("BookingPickupBranch")
  bookingReturns Booking[]     @relation("BookingReturnBranch")
  promotionScopes PromotionScope[]
  feeRules        FeeRule[]

  @@unique([tenantId, code])
  @@index([locationId])
  @@index([tenantId, status])
  @@map("branches")
}

/// Recurring operating hours (02-C04). dayOfWeek: 0=Monday…6=Sunday.
model LocationHours {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @db.Uuid
  dayOfWeek  Int
  opensAt    String
  closesAt   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@map("location_hours")
}

/// Exception hours overriding the recurring pattern for a specific date
/// (02-C05). Both opensAt/closesAt null = closed for the day.
model LocationHourException {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @db.Uuid
  date       DateTime @db.Date
  opensAt    String?
  closesAt   String?
  reason     String?
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@map("location_hour_exceptions")
}

/// Delivery zone baseline (02-C08). The polygon geometry arrives with the
/// spatial search phase (SQL adapter boundary); the fee policy reference
/// points into the pricing engine when it lands.
model DeliveryZone {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  name              String
  active            Boolean  @default(true)
  feePolicyReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quoteRecords      QuoteRecord[]
  bookings          Booking[]
  feeRules          FeeRule[]

  @@index([tenantId])
  @@map("delivery_zones")
}

/// Vehicle category (architecture/database-schema-v1.md §4
/// vehicle_categories). Localized name/description fields cover ar/fr/en
/// (03-A06); the fallback name is required.
model VehicleCategory {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  name             String
  nameAr           String?
  nameFr           String?
  code             String
  description      String?
  descriptionAr    String?
  descriptionFr    String?
  transmission     String?
  fuelType         String?
  seats            Int?
  doors            Int?
  luggageCapacity  Int?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles         Vehicle[]
  features         CategoryFeature[]
  bookingHolds     BookingHold[]
  quoteRecords     QuoteRecord[]
  bookingsRequested Booking[]        @relation("BookingRequestedCategory")
  ratePlanScopes   RatePlanScope[]
  promotionScopes  PromotionScope[]
  depositPolicyScopes DepositPolicyScope[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("vehicle_categories")
}

/// Per-category feature assignments from the versioned feature catalog
/// (apps/api/src/fleet/domain/feature-catalog.ts, 03-A03).
model CategoryFeature {
  id         String          @id @default(uuid()) @db.Uuid
  categoryId String          @db.Uuid
  featureKey String
  category   VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, featureKey])
  @@map("category_features")
}

/// Vehicle (architecture/database-schema-v1.md §4 vehicles).
model Vehicle {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  categoryId      String           @db.Uuid
  currentBranchId String?          @db.Uuid
  make            String
  model           String
  year            Int
  plateNumber     String
  vin             String?
  color           String?
  status          VehicleStatus    @default(AVAILABLE)
  acquisitionDate DateTime?        @db.Date
  acquisitionCost Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        VehicleCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentBranch   Branch?          @relation(fields: [currentBranchId], references: [id], onDelete: SetNull)
  odometer        OdometerReading[]
  images          VehicleImage[]
  documents       VehicleDocument[]
  blocks          VehicleBlock[]
  holds           BookingHold[]
  quoteRecords    QuoteRecord[]
  bookingsAssigned Booking[]         @relation("BookingAssignedVehicle")
  ratePlanScopes  RatePlanScope[]
  promotionScopes PromotionScope[]
  depositPolicyScopes DepositPolicyScope[]
  favoritedBy     CustomerFavorite[]
  recentlyViewedBy RecentlyViewedVehicle[]

  @@unique([tenantId, plateNumber])
  @@index([tenantId])
  @@index([categoryId])
  @@index([currentBranchId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("vehicles")
}

enum VehicleBlockType {
  MAINTENANCE
  INSPECTION
  DAMAGE
  TRANSFER
  MANUAL
  CLEANING
  OTHER
}

enum VehicleBlockStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingChannel {
  MARKETPLACE
  AGENCY_WEB
  STAFF
  PHONE
  WALK_IN
  IMPORT
}

enum BookingHoldStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONSUMED
}

model VehicleBlock {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  vehicleId String             @db.Uuid
  blockType VehicleBlockType
  startsAt  DateTime
  endsAt    DateTime
  status    VehicleBlockStatus @default(SCHEDULED)
  reason    String?
  createdBy String?            @db.Uuid
  createdAt DateTime           @default(now())
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle   Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId, startsAt, endsAt])
  @@map("vehicle_blocks")
}

model BookingHold {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  vehicleId  String?           @db.Uuid
  categoryId String?           @db.Uuid
  startsAt   DateTime
  endsAt     DateTime
  expiresAt  DateTime
  status     BookingHoldStatus @default(ACTIVE)
  channel    BookingChannel
  createdBy  String?           @db.Uuid
  bookingId  String?           @db.Uuid
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category   VehicleCategory?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  booking    Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([vehicleId, startsAt, endsAt])
  @@index([expiresAt])
  @@map("booking_holds")
}

enum InventoryMode {
  VEHICLE
  CATEGORY
}

/// Persisted quote record (05-A): immutable request context + the
/// server-computed availability answer and pricing slot at creation time
/// (architecture/database-schema-v1.md §8 quote_records). Pricing is null
/// until the pricing engine (PHASE-06) registers a provider.
model QuoteRecord {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  channel          BookingChannel
  inventoryMode    InventoryMode
  vehicleId        String?           @db.Uuid
  categoryId       String?           @db.Uuid
  pickupBranchId   String?           @db.Uuid
  returnBranchId   String?           @db.Uuid
  deliveryZoneId   String?           @db.Uuid
  startsAt         DateTime
  endsAt           DateTime
  expiresAt        DateTime
  availabilityJson Json
  pricingJson      Json?
  createdBy        String?           @db.Uuid
  createdAt        DateTime          @default(now())
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  category         VehicleCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pickupBranch     Branch?           @relation("QuotePickupBranch", fields: [pickupBranchId], references: [id], onDelete: SetNull)
  returnBranch     Branch?           @relation("QuoteReturnBranch", fields: [returnBranchId], references: [id], onDelete: SetNull)
  deliveryZone     DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  creator          User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  bookings         Booking[]

  @@index([tenantId, createdAt])
  @@map("quote_records")
}

enum BookingStatus {
  DRAFT
  HOLD
  PENDING_CONFIRMATION
  CONFIRMED
  READY_FOR_PICKUP
  ACTIVE
  RETURN_PENDING
  RETURNED
  SETTLEMENT_PENDING
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
  REJECTED
}

/// Booking aggregate root (05-B01): the committed rental workflow record
/// (architecture/database-schema-v1.md §6 bookings). Money amounts arrive
/// with the pricing engine (PHASE-06) via booking_price_snapshots; the
/// currency is the tenant default captured at creation.
model Booking {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  bookingNumber       String
  channel             BookingChannel
  inventoryMode       InventoryMode
  status              BookingStatus       @default(DRAFT)
  customerId          String?             @db.Uuid
  createdBy           String?             @db.Uuid
  quoteId             String?             @db.Uuid
  requestedCategoryId String?             @db.Uuid
  assignedVehicleId   String?             @db.Uuid
  pickupBranchId      String?             @db.Uuid
  returnBranchId      String?             @db.Uuid
  deliveryZoneId      String?             @db.Uuid
  startsAt            DateTime
  endsAt              DateTime
  currency            String              @default("DZD")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer?           @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  creator             User?               @relation("BookingCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  quote               QuoteRecord?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  requestedCategory   VehicleCategory?    @relation("BookingRequestedCategory", fields: [requestedCategoryId], references: [id], onDelete: SetNull)
  assignedVehicle     Vehicle?            @relation("BookingAssignedVehicle", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  pickupBranch        Branch?             @relation("BookingPickupBranch", fields: [pickupBranchId], references: [id], onDelete: SetNull)
  returnBranch        Branch?             @relation("BookingReturnBranch", fields: [returnBranchId], references: [id], onDelete: SetNull)
  deliveryZone        DeliveryZone?       @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  statusHistory       BookingStatusHistory[]
  priceSnapshots      BookingPriceSnapshot[]
  holds               BookingHold[]
  extensions          BookingExtension[]
  cancellations       BookingCancellation[]
  assignments         BookingAssignment[]
  idempotencyRecords  BookingIdempotencyRecord[]

  @@unique([tenantId, bookingNumber])
  @@index([tenantId, createdAt])
  @@index([assignedVehicleId])
  @@index([requestedCategoryId])
  @@map("bookings")
}

/// Append-only lifecycle transitions (05-B07): every status write goes
/// through here with actor, reason and correlation id.
model BookingStatusHistory {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @db.Uuid
  fromStatus    BookingStatus?
  toStatus      BookingStatus
  actorUserId   String?       @db.Uuid
  reason        String?
  correlationId String?
  createdAt     DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

/// Immutable commercial snapshot linkage (05-B06): the snapshot rows are
/// filled by the pricing engine (PHASE-06) at confirmation/invoicing.
model BookingPriceSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @db.Uuid
  pricingJson Json?
  capturedAt  DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // 06-D08: one immutable snapshot per booking — captured once at
  // confirmation, never rewritten.
  @@unique([bookingId])
  @@map("booking_price_snapshots")
}

/// Per-tenant booking number counter (05-B02): the source of the
/// human-readable, tenant-unique booking number sequence.
model BookingCounter {
  tenantId   String @id @db.Uuid
  nextNumber Int    @default(1)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("booking_counters")
}

enum BookingExtensionStatus {
  REQUESTED
  APPROVED
  REJECTED
}

/// Extension requests/results (05-D05/D06) — the original reservation
/// interval and pricing snapshot are never rewritten; the extension is a
/// distinct record whose financial adjustment arrives with PHASE-06.
model BookingExtension {
  id             String                 @id @default(uuid()) @db.Uuid
  bookingId      String                 @db.Uuid
  requestedEndsAt DateTime
  originalEndsAt DateTime
  status         BookingExtensionStatus @default(REQUESTED)
  reason         String?
  requestedBy    String?                @db.Uuid
  decidedBy      String?                @db.Uuid
  decidedAt      DateTime?
  pricingJson    Json?
  createdAt      DateTime               @default(now())
  booking        Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_extensions")
}

enum BookingCancellationInitiator {
  CUSTOMER
  AGENCY
}

/// Cancellation records (05-D01/D02): who initiated, why, and the policy
/// slot — policy version and the financial result are filled by the
/// pricing/payments phases (06/09).
model BookingCancellation {
  id              String                       @id @default(uuid()) @db.Uuid
  bookingId       String                       @db.Uuid
  initiator       BookingCancellationInitiator
  reason          String
  actorUserId     String?                      @db.Uuid
  policyVersion   String?
  financialResultJson Json?
  createdAt       DateTime                     @default(now())
  booking         Booking                      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_cancellations")
}

/// Assignment history (05-D07): previous and new vehicle per reassignment.
model BookingAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  bookingId     String   @db.Uuid
  fromVehicleId String?  @db.Uuid
  toVehicleId   String   @db.Uuid
  reason        String?
  actorUserId   String?  @db.Uuid
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_assignments")
}

/// Idempotency records (05-D09): safe retries for create/hold/confirm/
/// extension commands, keyed by tenant + authenticated actor + command.
/// Replayed requests return the original result.
model BookingIdempotencyRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorUserId   String   @db.Uuid
  command       String
  idempotencyKey String
  bookingId     String?  @db.Uuid
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([tenantId, actorUserId, command, idempotencyKey])
  @@map("booking_idempotency_records")
}

/// PHASE-06 / 06-A05: duration units a rate plan is expressed in. Tiers and
/// mixed-duration combination rules land with 06-B.
enum RateDurationUnit {
  HOURLY
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// PHASE-06 / 06-A01: tenant rate plan. Money is always an integer minor
/// amount (`baseRateMinor`) — never floating point (architecture/
/// pricing-engine.md; the exact-money library is 06-D01).
model RatePlan {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  code           String
  name           String
  currency       String           @default("DZD")
  durationUnit   RateDurationUnit
  baseRateMinor  Int
  /// 06-A06: higher wins within the same scope specificity; the remaining
  /// deterministic ordering is defined in the pricing domain.
  precedence     Int              @default(0)
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scopes RatePlanScope[]
  tiers  RatePlanTier[]
  adjustments RatePlanAdjustment[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("rate_plans")
}

/// PHASE-06 / 06-A04: applicability — a plan with no scopes applies
/// tenant-wide; each scope targets exactly one vehicle or one category.
model RatePlanScope {
  id         String   @id @default(uuid()) @db.Uuid
  ratePlanId String   @db.Uuid
  vehicleId  String?  @db.Uuid
  categoryId String?  @db.Uuid
  createdAt  DateTime @default(now())

  ratePlan RatePlan         @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([categoryId])
  @@map("rate_plan_scopes")
}

/// PHASE-06 / 06-B05: duration ladder within a plan — unit index `i` is
/// priced by the tier with the smallest `upToUnits >= i` (the open tier
/// with `upToUnits = null` covers the rest; absent tiers = `baseRateMinor`).
model RatePlanTier {
  id         String  @id @default(uuid()) @db.Uuid
  ratePlanId String  @db.Uuid
  upToUnits  Int?
  rateMinor  Int
  createdAt  DateTime @default(now())

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([ratePlanId])
  @@map("rate_plan_tiers")
}

/// PHASE-06 / 06-B06..B08: time rules — SEASONAL windows, SPECIAL_DATE /
/// HOLIDAY calendar dates, WEEKEND day-of-week sets (0=Sunday..6=Saturday).
/// PERCENT values are basis points (1500 = +15%); FLAT_PER_UNIT adds a
/// minor amount per started unit. `precedence` is unique per plan+kind, so
/// the matching rule is deterministic by constraint.
model RatePlanAdjustment {
  id             String              @id @default(uuid()) @db.Uuid
  ratePlanId     String              @db.Uuid
  kind           RateAdjustmentKind
  adjustmentType RateAdjustmentType
  windowStart    DateTime?
  windowEnd      DateTime?
  date           DateTime?           @db.Date
  daysOfWeek     Int[]
  valueMinor     Int
  precedence     Int
  createdAt      DateTime            @default(now())

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, kind, precedence])
  @@index([ratePlanId])
  @@map("rate_plan_adjustments")
}

/// 06-B06..B08 rule kinds; the stage order SEASONAL → WEEKEND → HOLIDAY →
/// SPECIAL_DATE is fixed in the pricing domain.
enum RateAdjustmentKind {
  SEASONAL
  SPECIAL_DATE
  WEEKEND
  HOLIDAY
}

enum RateAdjustmentType {
  PERCENT
  FLAT_PER_UNIT
}

/// PHASE-06 / 06-C: commercial adjustments — promotions (06-C01), coupons
/// (06-C02), typed extras (06-C03), fee rules (06-C04..C07), deposit
/// pricing (06-C08) and eligibility (06-C09). R1 stacking: a valid coupon
/// wins over promotions; promotions themselves do not stack — the single
/// best promotion applies (deterministic order in the pricing domain).

enum CommercialDiscountType {
  PERCENT
  FIXED_MINOR
}

/// 06-C01: promotion with optional duration requirement and redemption cap.
model Promotion {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  code             String
  name             String
  discountType     CommercialDiscountType
  valueMinor       Int
  minDurationUnits Int?
  durationUnit     RateDurationUnit?
  effectiveFrom    DateTime
  effectiveUntil   DateTime?
  maxRedemptions   Int?
  redemptionsCount Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scopes PromotionScope[]

  @@unique([tenantId, code])
  @@map("promotions")
}

/// 06-C01/09: eligibility — no scopes = tenant-wide; each row targets one
/// vehicle, one category or one branch.
model PromotionScope {
  id          String   @id @default(uuid()) @db.Uuid
  promotionId String   @db.Uuid
  vehicleId   String?  @db.Uuid
  categoryId  String?  @db.Uuid
  branchId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  promotion Promotion        @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category  VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branch    Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("promotion_scopes")
}

/// 06-C02: client-redeemed discount code with a usage cap. `usedCount` is
/// incremented atomically when a booking snapshot consumes the coupon
/// (06-D); the configuration window/limit checks are domain-side.
model Coupon {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  code         String
  name         String
  discountType CommercialDiscountType
  valueMinor   Int
  effectiveFrom DateTime
  effectiveUntil DateTime?
  maxUses      Int?
  usedCount    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("coupons")
}

/// 06-C03: typed extras catalog (architecture/pricing-engine.md "Extras"):
/// the agency prices its own catalog; clients can never submit amounts.
enum ExtraType {
  ADDITIONAL_DRIVER
  CHILD_SEAT
  GPS_DEVICE
  INSURANCE_OPTION
  ADDITIONAL_MILEAGE
  FUEL_CHARGE
  LATE_RETURN_CHARGE
  DELIVERY_SERVICE
  OTHER
}

enum ExtraPricingUnit {
  PER_BOOKING
  PER_DAY
  PER_RENTAL_UNIT
}

model Extra {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  key         String
  type        ExtraType
  name        String
  pricingUnit ExtraPricingUnit
  amountMinor Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("extras")
}

/// 06-C04..C07: context-computed fee rules. Absence of a rule = no fee.
enum FeeRuleKind {
  DELIVERY_FEE
  DISTANCE_FEE
  ONE_WAY_FEE
  AFTER_HOURS_FEE
}

model FeeRule {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  kind            FeeRuleKind
  /// DELIVERY_FEE/DISTANCE_FEE: applies when the delivery zone is used.
  deliveryZoneId  String?     @db.Uuid
  /// Pickup branch the rule applies to (null = all branches).
  branchId        String?     @db.Uuid
  /// Flat amount (delivery/one-way base).
  baseMinor       Int         @default(0)
  /// DISTANCE_FEE: minor amount per km (haversine, straight-line R1).
  perKmMinor      Int?
  /// AFTER_HOURS_FEE: charged once per out-of-hours pickup or return.
  perOccurrenceMinor Int?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
  @@map("fee_rules")
}

/// 06-C08: deposit pricing. The deposit is tracked separately from rental
/// revenue (architecture/pricing-engine.md); this is the pricing side —
/// the authorization/receipt/release lifecycle lands with payments (09).
enum DepositPolicyType {
  FIXED_MINOR
  PERCENT_OF_TOTAL
}

model DepositPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  depositType DepositPolicyType
  /// FIXED_MINOR: minor amount; PERCENT_OF_TOTAL: basis points.
  valueMinor  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scopes DepositPolicyScope[]

  @@map("deposit_policies")
}

/// 06-C08: per-vehicle/category deposit overrides; no scopes = global.
model DepositPolicyScope {
  id             String   @id @default(uuid()) @db.Uuid
  depositPolicyId String  @db.Uuid
  vehicleId      String?  @db.Uuid
  categoryId     String?  @db.Uuid
  createdAt      DateTime @default(now())

  depositPolicy DepositPolicy   @relation(fields: [depositPolicyId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category      VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("deposit_policy_scopes")
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INSPECTION
  ARCHIVED
}

enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
  INSPECTION_CERTIFICATE
  CUSTOMS
  OTHER
}

/// Private vehicle gallery image (03-C04/05). Binary content lives in object
/// storage (Cloudflare R2); only the object key and metadata are stored here.
/// Access is exclusively through signed URLs (03-C08).
model VehicleImage {
  id             String   @id @default(uuid()) @db.Uuid
  vehicleId      String   @db.Uuid
  objectKey      String   @unique
  contentType    String
  sizeBytes      Int
  checksumSha256 String?
  position       Int      @default(0)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
  @@map("vehicle_images")
}

/// Private vehicle document (03-C06/07). Same private-object policy as
/// images; expiry rules are enforced server-side.
model VehicleDocument {
  id          String              @id @default(uuid()) @db.Uuid
  vehicleId   String              @db.Uuid
  type        VehicleDocumentType
  title       String
  objectKey   String              @unique
  contentType String
  sizeBytes   Int
  issuedAt    DateTime?           @db.Date
  expiresAt   DateTime?           @db.Date
  createdAt   DateTime            @default(now())
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_documents")
}

/// Odometer/fuel reading records (03-B05/06).
model OdometerReading {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @db.Uuid
  odometerKm Int
  fuelLevelPercent Int?
  recordedAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@map("odometer_readings")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE-07 / 07-A — Customer Identity & Profile
// Authority: architecture/database-schema-v1.md §5 (tenant-scoped customer
// master + documents), architecture/customer-platform.md (R1 decisions).
//
// Customer records are tenant-scoped: the same person may exist independently
// in different agencies (policy-driven uniqueness — no cross-tenant sharing).
// The marketplace account is the application User; `userId` links the two
// (07-A02, one link per tenant). Since 07-E05 (booking portal customer
// information form), bookings reference the tenant's customer record
// (`bookings.customerId` → `customers.id`) — the tenant scope of the
// customer master is what keeps cross-tenant leakage out of bookings.
// ─────────────────────────────────────────────────────────────────────────────

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Tenant-scoped business/customer profile (database-schema-v1 §5.1).
model Customer {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  userId            String?            @db.Uuid
  firstName         String
  lastName          String
  phone             String?
  email             String?
  preferredLocale   String             @default("en")
  dateOfBirth       DateTime?          @db.Date
  licenseNumber     String?
  licenseCountry    String?
  licenseIssueDate  DateTime?          @db.Date
  licenseExpiryDate DateTime?          @db.Date
  status            CustomerStatus     @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents         CustomerDocument[]
  bookings          Booking[]          @relation("BookingCustomer")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("customers")
}

enum CustomerDocumentType {
  DRIVER_LICENSE
  NATIONAL_ID
  PASSPORT
  RESIDENCE_PERMIT
  OTHER
}

enum CustomerDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Identity/eligibility document evidence for a customer record
/// (database-schema-v1 §5.2). Verification is manual (agency staff); the
/// media object reference is a plain UUID until the media_objects storage
/// table lands (03-C follow-up).
/// PHASE-08 / 08-A02: the agency's document policy — which customer
/// document types the agency requires for its bookings, and whether a
/// passport is additionally required for customers whose driving license
/// was issued outside Algeria. One active policy per agency; an agency
/// without a row runs the default policy (driving license only).
model AgencyDocumentPolicy {
  id                              String               @id @default(uuid()) @db.Uuid
  tenantId                        String               @db.Uuid
  requiredTypes                   CustomerDocumentType[]
  requirePassportForForeignLicense Boolean              @default(false)
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt
  tenant                          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("agency_document_policies")
}

model CustomerDocument {
  id              String                 @id @default(uuid()) @db.Uuid
  customerId      String                 @db.Uuid
  type            CustomerDocumentType
  number          String?
  issueDate       DateTime?              @db.Date
  expiryDate      DateTime?              @db.Date
  status          CustomerDocumentStatus @default(PENDING)
  mediaObjectId   String?                @db.Uuid
  verifiedAt      DateTime?
  verifiedBy      String?                @db.Uuid
  rejectionReason String?
  createdAt       DateTime               @default(now())
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
  @@index([customerId])
  @@map("customer_documents")
}

/// Marketplace favorites (07-A05) — user-scoped, cross-agency.
model CustomerFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  vehicleId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@map("customer_favorites")
}

/// Recently viewed vehicles (07-A06) — one row per user/vehicle pair,
/// upserted on view with a per-user cap (20).
model RecentlyViewedVehicle {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  vehicleId String   @db.Uuid
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@index([userId, viewedAt])
  @@map("recently_viewed_vehicles")
}

/// Search history baseline (07-A07) — criteria snapshot per user, capped
/// per user (50). Criteria are JSON snapshots, never executable input.
model SearchHistoryEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  criteria  Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}
