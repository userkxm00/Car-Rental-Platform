// KAVRIQO database schema — Phase 01 baseline.
//
// Authority: architecture/database-schema-v1.md (logical model),
// architecture/database-architecture.md (Prisma + PostGIS boundary),
// docs/35-database-and-backend-foundations.md.
//
// Conventions:
// - Prisma is the primary data-access layer; PostGIS-specific fields and
//   queries use the documented narrow SQL adapter boundary (not yet needed
//   in Phase 01 — no geographic types in the users baseline).
// - No secrets (passwords/tokens) are ever stored: identity is external
//   (Supabase Auth) and only provider subjects are linked.

generator client {
  provider = "prisma-client-js"
  // Driver-adapter (pg) engine mode: no native engine download is needed,
  // which also keeps generation fully offline-capable.
  engineType = "client"
  // Generated client must sit inside apps/api/node_modules so
  // @prisma/client's `require('.prisma/client')` resolves it.
  output = "../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Global identity record (architecture/database-schema-v1.md §2).
/// At least one supported login identifier is required (email or phone —
/// enforced by a CHECK constraint added in the migration SQL).
model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String?          @unique
  phone           String?          @unique
  displayName     String
  preferredLocale String           @default("en")
  timezone        String?
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  identities      UserIdentity[]
  memberships     Membership[]

  @@map("users")
}

/// Provider subject → application user link. Provider identifiers stay in
/// this table and never leak into domain entities.
model UserIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

/// Agency/company account (architecture/database-schema-v1.md §2 tenants).
/// Every tenant-owned table references tenantId; tenant scope is enforced by
/// repository helpers (02-D02), never by client-supplied identifiers.
model Tenant {
  id                String                   @id @default(uuid()) @db.Uuid
  name              String
  legalName         String?
  slug              String                   @unique
  defaultLocale     String                   @default("en")
  defaultTimezone   String?
  defaultCurrency   String                   @default("DZD")
  status            TenantStatus             @default(ACTIVE)
  marketplaceEnabled Boolean                 @default(false)
  verificationStatus TenantVerificationStatus @default(UNVERIFIED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  memberships       Membership[]
  locations         Location[]
  branches          Branch[]
  deliveryZones     DeliveryZone[]
  vehicleCategories VehicleCategory[]
  vehicles          Vehicle[]

  @@map("tenants")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DECLINED
  REMOVED
}

/// Relation between a user and an agency (architecture/database-schema-v1.md
/// §2 memberships). One user may belong to multiple agencies; within one
/// agency the pair is unique.
model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  status    MembershipStatus @default(INVITED)
  invitedAt DateTime         @default(now())
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Assigns one or more roles to a membership (architecture/
/// database-schema-v1.md §2 membership_roles). Role keys are the versioned
/// catalog in apps/api/src/authorization/roles.ts (validated server-side).
model MembershipRole {
  id           String     @id @default(uuid()) @db.Uuid
  membershipId String     @db.Uuid
  role         String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@map("membership_roles")
}

enum BranchStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum LocationType {
  BRANCH
  AIRPORT
  HOTEL
  PARKING
  PICKUP_POINT
  CUSTOM
}

/// Canonical location entity (architecture/database-schema-v1.md §3).
/// tenantId null = platform/global location. The PostGIS geometry column is
/// added with the spatial search phase via the documented SQL adapter
/// boundary; lat/lng columns serve the display fallback.
model Location {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String?                @db.Uuid
  type           LocationType           @default(CUSTOM)
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  countryCode    String                 @default("DZ")
  latitude       Float?
  longitude      Float?
  providerName   String?
  providerPlaceId String?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches       Branch[]
  hours          LocationHours[]
  hourExceptions LocationHourException[]

  @@index([tenantId])
  @@map("locations")
}

/// Branch (architecture/database-schema-v1.md §3). Code is unique within a
/// tenant; the referenced location must be global or owned by the same
/// tenant (enforced by the branches service, 02-C03).
model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  name       String
  code       String
  locationId String       @db.Uuid
  status     BranchStatus @default(ACTIVE)
  timezone   String?
  contacts   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@index([locationId])
  @@map("branches")
}

/// Recurring operating hours (02-C04). dayOfWeek: 0=Monday…6=Sunday.
model LocationHours {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @db.Uuid
  dayOfWeek  Int
  opensAt    String
  closesAt   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@map("location_hours")
}

/// Exception hours overriding the recurring pattern for a specific date
/// (02-C05). Both opensAt/closesAt null = closed for the day.
model LocationHourException {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @db.Uuid
  date       DateTime @db.Date
  opensAt    String?
  closesAt   String?
  reason     String?
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@map("location_hour_exceptions")
}

/// Delivery zone baseline (02-C08). The polygon geometry arrives with the
/// spatial search phase (SQL adapter boundary); the fee policy reference
/// points into the pricing engine when it lands.
model DeliveryZone {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  name              String
  active            Boolean  @default(true)
  feePolicyReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("delivery_zones")
}

/// Vehicle category (architecture/database-schema-v1.md §4
/// vehicle_categories). Localized name/description fields cover ar/fr/en
/// (03-A06); the fallback name is required.
model VehicleCategory {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  name             String
  nameAr           String?
  nameFr           String?
  code             String
  description      String?
  descriptionAr    String?
  descriptionFr    String?
  transmission     String?
  fuelType         String?
  seats            Int?
  doors            Int?
  luggageCapacity  Int?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles         Vehicle[]
  features         CategoryFeature[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("vehicle_categories")
}

/// Per-category feature assignments from the versioned feature catalog
/// (apps/api/src/fleet/domain/feature-catalog.ts, 03-A03).
model CategoryFeature {
  id         String          @id @default(uuid()) @db.Uuid
  categoryId String          @db.Uuid
  featureKey String
  category   VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, featureKey])
  @@map("category_features")
}

/// Vehicle (architecture/database-schema-v1.md §4 vehicles).
model Vehicle {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  categoryId      String           @db.Uuid
  currentBranchId String?          @db.Uuid
  make            String
  model           String
  year            Int
  plateNumber     String
  vin             String?
  color           String?
  status          VehicleStatus    @default(AVAILABLE)
  acquisitionDate DateTime?        @db.Date
  acquisitionCost Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        VehicleCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  odometer        OdometerReading[]
  images          VehicleImage[]
  documents       VehicleDocument[]

  @@unique([tenantId, plateNumber])
  @@index([tenantId])
  @@index([categoryId])
  @@index([currentBranchId])
  @@map("vehicles")
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INSPECTION
  ARCHIVED
}

enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
  INSPECTION_CERTIFICATE
  CUSTOMS
  OTHER
}

/// Private vehicle gallery image (03-C04/05). Binary content lives in object
/// storage (Cloudflare R2); only the object key and metadata are stored here.
/// Access is exclusively through signed URLs (03-C08).
model VehicleImage {
  id             String   @id @default(uuid()) @db.Uuid
  vehicleId      String   @db.Uuid
  objectKey      String   @unique
  contentType    String
  sizeBytes      Int
  checksumSha256 String?
  position       Int      @default(0)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
  @@map("vehicle_images")
}

/// Private vehicle document (03-C06/07). Same private-object policy as
/// images; expiry rules are enforced server-side.
model VehicleDocument {
  id          String              @id @default(uuid()) @db.Uuid
  vehicleId   String              @db.Uuid
  type        VehicleDocumentType
  title       String
  objectKey   String              @unique
  contentType String
  sizeBytes   Int
  issuedAt    DateTime?           @db.Date
  expiresAt   DateTime?           @db.Date
  createdAt   DateTime            @default(now())
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_documents")
}

/// Odometer/fuel reading records (03-B05/06).
model OdometerReading {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @db.Uuid
  odometerKm Int
  fuelLevelPercent Int?
  recordedAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@map("odometer_readings")
}
